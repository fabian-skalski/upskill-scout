AIRFLOW_API_INTERNAL_PORT=8080
AIRFLOW_WORKER_INTERNAL_PORT=8080
AIRFLOW_SCHEDULER_INTERNAL_PORT=8080
AIRFLOW_TRIGGERER_INTERNAL_PORT=8080

# Redis Configuration
REDIS_HOST=redis
REDIS_PASSWORD=

# Milvus Configuration
MILVUS_URI=http://milvus-standalone:19530
MILVUS_DB_NAME=default
MILVUS_COLLECTION_NAME=postings

# Etcd Configuration
ETCD_ENDPOINTS=etcd:2379

# MinIO Configuration
MINIO_ADDRESS=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# PostgreSQL Configuration (for Airflow)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB_AIRFLOW=airflow
POSTGRES_DB_MLFLOW=mlflow
POSTGRES_PORT=5432
POSTGRES_INTERNAL_PORT=5432

# ML Flow Configuration
MLFLOW_PORT=5009
MLFLOW_INTERNAL_PORT=5000
MLFLOW_BUCKET_NAME_MINIO=mlflow

# Backend URL for Airflow
BACKEND_URL=http://backend:8000

# Model Configuration (Ollama models)
MODEL_GEN=deepseek-r1:1.5b-qwen-distill-q8_0
MODEL_EMB=embeddinggemma:300m-qat-q8_0
EMBEDDING_DIM=768  # embeddinggemma:latest produces 768-dimensional embeddings

# LLM Generation & Embedding Model Parameters
GEN_TEMPERATURE=0.7
GEN_MAX_TOKENS=2000
GEN_MAX_RETRIES=3

# Airflow Processing Parameters
MIN_POSTS_FOR_OVERVIEW=3
UMAP_N_NEIGHBORS=10
UMAP_MIN_DIST=0.0
UMAP_N_COMPONENTS=2
UMAP_METRIC=cosine
HDBSCAN_MIN_CLUSTER_SIZE=10
HDBSCAN_MIN_SAMPLES=10
HDBSCAN_METRIC=euclidean
REQUEST_TIMEOUT=300