# ============================================================================
# ENVIRONMENT CONFIGURATION
# Copy this file to .env and adjust values as needed
# ============================================================================

# Service Ports
BACKEND_PORT=8000
BACKEND_INTERNAL_PORT=8000
LLM_SERVICE_PORT=8001
LLM_SERVICE_INTERNAL_PORT=8001
REDIS_PORT=6379
REDIS_RETRIES=3
REDIS_DB=0
REDIS_INTERNAL_PORT=6379
REDISINSIGHT_PORT=5540
REDISINSIGHT_INTERNAL_PORT=5540
MINIO_CONSOLE_PORT=9001
MINIO_API_PORT=9000
MILVUS_PORT=19530
MILVUS_METRICS_PORT=9091
ETCD_PORT=2379
FLUENTD_PORT=24224
OLLAMA_PORT=11434
OLLAMA_INTERNAL_PORT=11434
ATTU_PORT=8002
ATTU_INTERNAL_PORT=3000

# Airflow Ports
AIRFLOW_WEBSERVER_PORT=8080
AIRFLOW_WEBSERVER_INTERNAL_PORT=8080
AIRFLOW_WORKER_INTERNAL_PORT=8080
AIRFLOW_SCHEDULER_INTERNAL_PORT=8080

# Redis Configuration
REDIS_HOST=redis
REDIS_PASSWORD=

# Milvus Configuration
MILVUS_URI=http://milvus-standalone:19530
MILVUS_DB_NAME=default
MILVUS_COLLECTION_NAME=postings

# Etcd Configuration
ETCD_ENDPOINTS=etcd:2379

# MinIO Configuration
MINIO_ADDRESS=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# PostgreSQL Configuration (for Airflow)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
POSTGRES_INTERNAL_PORT=

# Airflow Configuration
AIRFLOW_FERNET_KEY=
AIRFLOW_WWW_USER_USERNAME=
AIRFLOW_WWW_USER_PASSWORD=

# Attu Configuration
ATTU_PORT=3000

# LLM Service Configuration
LLM_SERVICE_URL=http://llm-service:8001
OLLAMA_PORT=11434

# Model Configuration (Ollama models)
MODEL_GEN=gemma3:270m
MODEL_EMB=embeddinggemma:300m-qat-q8_0
EMBEDDING_DIM=768  # embeddinggemma:latest produces 768-dimensional embeddings

# LLM Generation Parameters
GEN_TEMPERATURE=0.7
GEN_MAX_TOKENS=200
GEN_TIMEOUT=60

# Embedding Parameters
EMB_TIMEOUT=30

# Prompt Templates
PROMPT_EXTRACT=Extract Occupation Title (max 10 words) and Skills from:\\n\\n{text}\\n\\nFormat:\\nTitle: ...\\nSkills: skill1, skill2...

# Docker Volume Directory (optional)
DOCKER_VOLUME_DIRECTORY=.
